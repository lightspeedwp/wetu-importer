{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Africa/Johannesburg",
  "schedule": [
    "before 6am on monday"
  ],
  "labels": [
    "area:dependencies"
  ],
  "prConcurrentLimit": 10,
  "enabledManagers": [
    "github-actions",
    "npm",
    "composer"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ]
  },
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "addLabels": [
        "github_actions"
      ]
    },
    {
      "groupName": "phpcs",
      "matchPackageNames": [
        "wp-coding-standards/wpcs",
        "dealerdirect/phpcodesniffer-composer-installer",
        "phpcompatibility/phpcompatibility-wp"
      ]
    },
    {
      "description": "Plugins and themes installed only for local testing",
      "groupName": "wpackagist",
      "matchPackageNames": [
        "wpackagist-plugin/**",
        "wpackagist-theme/**"
      ]
    },
    {
      "description": "Mergify auto-merges every renovate[bot] PR once the checks it requires pass. Draft PRs cannot be merged, so major updates and lock-file refreshes wait for a person to mark them ready for review.",
      "matchUpdateTypes": [
        "major",
        "lockFileMaintenance"
      ],
      "draftPR": true
    }
  ]
}
